{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "opensourcetogether",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-03-29",
	"compatibility_flags": [
		"nodejs_compat"
	],
	// Custom domain routing — uncomment once the zone is on this Cloudflare
	// account. Until then the worker serves at opensourcetogether.workers.dev.
	// "routes": [
	// 	{ "pattern": "opensourcetogether.dev", "custom_domain": true }
	// ],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "opensourcetogether",
			// Run `wrangler d1 create opensourcetogether` and paste the ID here
			// before the first deploy. Local dev (emdash dev / wrangler dev)
			// works without it via miniflare.
			"database_id": "85fb71ea-c706-433b-94d0-c38126af0bb9",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			// Run `wrangler r2 bucket create opensourcetogether-media` first.
			"bucket_name": "opensourcetogether-media",
		},
	],
	// Astro sessions (used by EmDash auth) are stored in Workers KV in
	// production. Run `wrangler kv namespace create SESSION` and paste the
	// id here. Local dev auto-provisions this via miniflare.
	"kv_namespaces": [
		{
			"binding": "SESSION",
			"id": "c48858fa5700482da5ed74e0b83ab4a8",
		},
	],
	"observability": {
		"enabled": true,
	},
	// Worker Loader (Dynamic Workers) requires Workers Paid. Uncomment together
	// with sandboxed webhook-notifier in astro.config.mjs once upgraded:
	// "worker_loaders": [
	// 	{ "binding": "LOADER" }
	// ],
	// Drives scheduled publishing, plugin cron, and maintenance (see src/worker.ts)
	"triggers": {
		"crons": ["* * * * *"],
	},
}
