# opensourcetogether — environment variables
#
# Local development needs NO environment variables. `npx emdash dev` runs
# migrations, seeds, and type generation against local D1/R2 emulation
# (state lives in .wrangler/state/, gitignored).
#
# IndieWeb media-lookup API keys (TMDB, RAWG, Last.fm, Foursquare,
# PodcastIndex) are NOT env vars — they are entered in the admin UI under
# IndieWeb > API Connections and stored in plugin storage.

# --- Deployment (wrangler) -------------------------------------------------
# Only needed for non-interactive deploys (CI). For local deploys prefer
# `wrangler login`.
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=

# --- Site ------------------------------------------------------------------
# Canonical site origin, used at build time when set (falls back to the
# value in astro.config.mjs).
# SITE_URL=https://opensourcetogether.dev
