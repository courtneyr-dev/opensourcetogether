---
import { getEmDashCollection, getEntryTerms } from "emdash";
import Base from "../../layouts/Base.astro";
import { getReadingTime } from "../../utils/reading-time";
import { getKindFormat } from "../../utils/kind-format";

const { entries: posts, cacheHint } = await getEmDashCollection("posts");

Astro.cache.set(cacheHint);

const sortedPosts = posts.toSorted((a, b) => {
	const dateA = a.data.publishedAt?.getTime() ?? 0;
	const dateB = b.data.publishedAt?.getTime() ?? 0;
	return dateB - dateA;
});

// Fetch tags for each post (bylines are already hydrated by getEmDashCollection)
const postsWithTags = await Promise.all(
	sortedPosts.map(async (post) => {
		const tags = await getEntryTerms("posts", post.data.id, "tag");
		const bylines = post.data.bylines ?? [];
		const kind = post.data.kind ?? "article";
		return { post, tags, bylines, kindFormat: getKindFormat(kind) };
	})
);

const formatDate = (date: Date) =>
	date.toLocaleDateString("en-US", {
		year: "numeric",
		month: "long",
		day: "numeric",
	});
---

<Base title="All Posts" description="Browse all posts, notes, and responses">
	<div class="posts-page h-feed">
		<header class="page-header">
			<span class="cr-eyebrow">The stream</span>
			<h1 class="page-title p-name">All Posts</h1>
			<p class="page-description">
				{posts.length}
				{posts.length === 1 ? "entry" : "entries"} — every kind, newest first
			</p>
		</header>

		{
			sortedPosts.length === 0 ? (
				<p class="empty">No posts yet.</p>
			) : (
				<div class="cr-stream posts-stream">
					{postsWithTags.map(({ post, tags, bylines, kindFormat }) => (
						<article
							class={`cr-stream-item cr-stream-item--${kindFormat.chipType} h-entry`}
						>
							<div class="cr-stream-item__avatar" aria-hidden="true">
								{kindFormat.emoji}
							</div>
							<div class="cr-stream-item__body">
								<div class="cr-stream-item__meta">
									<span
										class={`cr-chip cr-chip--${kindFormat.chipType}`}
									>
										{kindFormat.label}
									</span>
									{post.data.publishedAt && (
										<time
											class="dt-published"
											datetime={post.data.publishedAt.toISOString()}
										>
											{formatDate(post.data.publishedAt)}
										</time>
									)}
									{kindFormat.format === "standard" && (
										<span>{getReadingTime(post.data.content)} min read</span>
									)}
									{bylines.length > 0 && (
										<span class="stream-byline">
											{bylines
												.slice(0, 2)
												.map((c) => c.byline.displayName)
												.join(", ")}
										</span>
									)}
								</div>
								{post.data.title ? (
									<h2 class="cr-stream-item__title">
										<a class="u-url p-name" href={`/posts/${post.id}`}>
											{post.data.title}
										</a>
									</h2>
								) : (
									<p class="stream-note p-name">
										<a class="u-url stream-note-link" href={`/posts/${post.id}`}>
											{post.data.excerpt ?? "Untitled"}
										</a>
									</p>
								)}
								{post.data.title && post.data.excerpt && (
									<p class="stream-excerpt p-summary">{post.data.excerpt}</p>
								)}
								{tags.length > 0 && (
									<div class="cr-stream-item__tags">
										{tags.slice(0, 3).map((t) => (
											<a href={`/tag/${t.slug}`} class="stream-tag p-category">
												{t.label}
											</a>
										))}
									</div>
								)}
							</div>
						</article>
					))}
				</div>
			)
		}
	</div>
</Base>

<style>
	.posts-page {
		max-width: var(--cr-measure-wide);
		margin: 0 auto;
		padding: var(--spacing-8) var(--spacing-6) var(--spacing-16);
	}

	.page-header {
		margin-bottom: var(--spacing-8);
	}

	.page-title {
		font-size: var(--cr-text-4xl);
		font-weight: var(--cr-weight-black);
		letter-spacing: var(--cr-tracking-tight);
		margin: 0 0 var(--spacing-2);
	}

	.page-description {
		font-size: var(--font-size-lg);
		color: var(--color-muted);
	}

	.empty {
		color: var(--color-muted);
		font-size: var(--font-size-lg);
	}

	.posts-stream {
		padding: 0;
	}

	.stream-byline {
		color: var(--color-muted);
	}

	/* Title-less kinds (notes, likes, ...) — the excerpt is the content */
	.stream-note {
		font-size: var(--font-size-lg);
		line-height: var(--leading-relaxed);
		margin: 0 0 var(--spacing-2);
		max-width: var(--cr-measure);
	}

	.stream-note-link {
		color: var(--cr-ink);
		text-decoration: none;
	}

	.stream-note-link:hover {
		color: var(--cr-link);
	}

	.stream-excerpt {
		font-size: var(--font-size-base);
		line-height: var(--leading-relaxed);
		color: var(--color-text-secondary);
		margin: 0;
		max-width: var(--cr-measure);
	}

	/* Tags — masking tape */
	.stream-tag {
		display: inline-block;
		padding: var(--tag-padding-y) var(--spacing-2);
		font-family: var(--cr-font-accent);
		font-size: var(--font-size-xs);
		font-weight: var(--cr-weight-bold);
		color: var(--cr-tape-ink);
		background: var(--cr-tape);
		text-decoration: none;
		transition: background var(--transition-fast);
	}

	.stream-tag:hover {
		background: var(--cr-highlight);
		color: var(--cr-prussian-blue);
	}

	@media (max-width: 600px) {
		.posts-page {
			padding: var(--spacing-6) var(--spacing-4) var(--spacing-12);
		}

		.page-title {
			font-size: var(--cr-text-3xl);
		}
	}
</style>
