---
/**
 * IndieAuth authorization endpoint.
 *
 * GET: validates the authorization request and renders a consent
 * screen. Requires an EmDash admin session — anonymous visitors are
 * redirected to the admin login and returned here after.
 *
 * POST (consent form): issues a single-use authorization code and
 * redirects back to the client with `code`, `state`, and `iss`.
 *
 * POST (grant_type=authorization_code): profile-URL redemption for
 * clients that only need identity (no access token).
 *
 * @see https://indieauth.spec.indieweb.org/#authorization-endpoint
 */
import {
	validateAuthorizationRequest,
	isAuthorizationServerError,
} from "@opensourcetogether/indieweb-core/indieauth";
import type { ValidatedAuthorizationRequest } from "@opensourcetogether/indieweb-core/indieauth";
import Base from "../../layouts/Base.astro";
import {
	callPrivatePluginRoute,
	callPublicPluginRoute,
	jsonResponse,
} from "../../utils/indieweb";

export const prerender = false;

const me = `${Astro.url.origin}/`;

if (Astro.request.method === "POST") {
	const form = new URLSearchParams(await Astro.request.text());

	// Profile-URL redemption (public, secured by code + PKCE).
	if (form.get("grant_type") === "authorization_code") {
		const result = await callPublicPluginRoute(Astro, "/indieauth-redeem", {
			grantType: "authorization_code",
			code: form.get("code") ?? undefined,
			clientId: form.get("client_id") ?? undefined,
			redirectUri: form.get("redirect_uri") ?? undefined,
			codeVerifier: form.get("code_verifier") ?? undefined,
			flow: "profile",
		});
		if (!result.success) {
			return jsonResponse(
				{ error: "server_error", error_description: "Redemption failed" },
				500,
			);
		}
		const redeemed = result.data as Record<string, unknown>;
		return jsonResponse(redeemed, redeemed.error ? 400 : 200);
	}

	// Consent submission — admin session required.
	if (!Astro.locals.user) {
		return new Response("Unauthorized", { status: 401 });
	}
	const validated = validateAuthorizationRequest({
		response_type: "code",
		client_id: form.get("client_id") ?? undefined,
		redirect_uri: form.get("redirect_uri") ?? undefined,
		state: form.get("state") ?? undefined,
		code_challenge: form.get("code_challenge") ?? undefined,
		code_challenge_method: "S256",
		scope: form.get("scope") ?? undefined,
	});
	if (isAuthorizationServerError(validated)) {
		return jsonResponse(validated, 400);
	}

	// Only scopes the admin left checked are granted.
	const grantedScopes = validated.scopes.filter(
		(scope) => form.get(`scope_${scope}`) === "on",
	);

	const issued = await callPrivatePluginRoute(Astro, "/indieauth-issue", {
		clientId: validated.clientId,
		redirectUri: validated.redirectUri,
		codeChallenge: validated.codeChallenge,
		scopes: grantedScopes,
		me,
	});
	if (!issued.success) {
		return jsonResponse(
			{
				error: "server_error",
				error_description: issued.error?.message ?? "Code issuance failed",
			},
			500,
		);
	}
	const { code } = issued.data as { code: string };

	const redirect = new URL(validated.redirectUri);
	redirect.searchParams.set("code", code);
	redirect.searchParams.set("state", validated.state);
	redirect.searchParams.set("iss", me);
	return Astro.redirect(redirect.toString(), 302);
}

// ── GET: consent screen ─────────────────────────────────────────────
const params = Object.fromEntries(Astro.url.searchParams.entries());
const validation = validateAuthorizationRequest(params);
const requestError = isAuthorizationServerError(validation)
	? validation
	: null;

if (!requestError && !Astro.locals.user) {
	const loginUrl = new URL("/_emdash/admin/login", Astro.url.origin);
	loginUrl.searchParams.set(
		"redirect",
		Astro.url.pathname + Astro.url.search,
	);
	return Astro.redirect(loginUrl.toString(), 302);
}

if (requestError) {
	Astro.response.status = 400;
}

const request: ValidatedAuthorizationRequest | null =
	isAuthorizationServerError(validation) ? null : validation;
const clientHost = request
	? (() => {
			try {
				return new URL(request.clientId).hostname;
			} catch {
				return request.clientId;
			}
		})()
	: "";

const scopeDescriptions: Record<string, string> = {
	create: "Create new posts",
	update: "Edit existing posts",
	delete: "Delete posts",
	media: "Upload media files",
	profile: "Read your profile information",
};
---

<Base title="Authorize application" robots="noindex, nofollow">
	<section class="auth-consent">
		{
			requestError ? (
				<div class="consent-card">
					<h1>Invalid authorization request</h1>
					<p class="consent-error">{requestError.error_description}</p>
					<p>
						<a href="/">Return home</a>
					</p>
				</div>
			) : (
				<form method="POST" class="consent-card">
					<h1>Authorize application</h1>
					<p>
						<a href={request!.clientId} rel="nofollow noopener">
							{clientHost}
						</a>{" "}
						wants to sign in as <strong>{me}</strong>.
					</p>

					{request!.scopes.length > 0 ? (
						<fieldset class="consent-scopes">
							<legend>Requested permissions</legend>
							{request!.scopes.map((scope) => (
								<label class="consent-scope">
									<input type="checkbox" name={`scope_${scope}`} checked />
									<span>
										<strong>{scope}</strong>
										{scopeDescriptions[scope] && (
											<em> — {scopeDescriptions[scope]}</em>
										)}
									</span>
								</label>
							))}
						</fieldset>
					) : (
						<p class="consent-note">
							This application only requests your identity — no access to
							your content.
						</p>
					)}

					<input type="hidden" name="client_id" value={request!.clientId} />
					<input
						type="hidden"
						name="redirect_uri"
						value={request!.redirectUri}
					/>
					<input type="hidden" name="state" value={request!.state} />
					<input
						type="hidden"
						name="code_challenge"
						value={request!.codeChallenge}
					/>
					<input type="hidden" name="scope" value={request!.scopes.join(" ")} />

					<div class="consent-actions">
						<button type="submit" class="consent-approve">
							Approve
						</button>
						<a href="/" class="consent-deny">
							Cancel
						</a>
					</div>
					<p class="consent-meta">
						Signed in as {Astro.locals.user?.email ?? "admin"}. You will be
						redirected to <code>{request!.redirectUri}</code>.
					</p>
				</form>
			)
		}
	</section>
</Base>

<style>
	.auth-consent {
		max-width: 480px;
		margin: var(--spacing-16) auto;
		padding: 0 var(--spacing-6);
	}

	.consent-card {
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		padding: var(--spacing-8);
		background: var(--color-bg-subtle);
	}

	.consent-card h1 {
		font-size: var(--font-size-2xl);
		margin-bottom: var(--spacing-4);
	}

	.consent-error {
		color: #b3261e;
	}

	.consent-scopes {
		margin: var(--spacing-6) 0;
		padding: var(--spacing-4);
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
	}

	.consent-scope {
		display: flex;
		gap: var(--spacing-2);
		align-items: baseline;
		margin: var(--spacing-2) 0;
		font-size: var(--font-size-sm);
	}

	.consent-note {
		margin: var(--spacing-4) 0;
		font-size: var(--font-size-sm);
		color: var(--color-text-secondary);
	}

	.consent-actions {
		display: flex;
		gap: var(--spacing-4);
		align-items: center;
		margin-top: var(--spacing-6);
	}

	.consent-approve {
		padding: var(--spacing-2) var(--spacing-6);
		background: var(--color-accent);
		color: var(--color-on-accent);
		border: none;
		border-radius: var(--radius);
		font-size: var(--font-size-base);
		cursor: pointer;
	}

	.consent-approve:hover {
		background: var(--color-accent-hover);
	}

	.consent-deny {
		color: var(--color-text-secondary);
	}

	.consent-meta {
		margin-top: var(--spacing-6);
		font-size: var(--font-size-xs);
		color: var(--color-muted);
		word-break: break-all;
	}
</style>
